# Use a standard Node.js 18 LTS image (Debian-based) for maximum compatibility
FROM node:22

# Set the working directory inside the container
WORKDIR /app

# Copy package.json and package-lock.json (if you have one)
# This allows Docker to cache the npm install step
COPY package.json ./
# COPY package-lock.json ./ # Uncomment if you use package-lock.json

# Install application dependencies (excluding AppDynamics, as it's removed from package.json)
RUN npm install

# Copy the locally unzipped AppDynamics agent into node_modules
# Ensure 'appdynamics-agent-local/appdynamics' matches the path to the actual module folder
COPY /appdynamics ./node_modules/appdynamics

# Copy the rest of your application code
COPY . .

# Expose the port the application listens on
EXPOSE 3000

# Command to run the application
CMD ["node", "index.js"]